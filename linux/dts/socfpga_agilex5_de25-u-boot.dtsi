/*
 * U-Boot / SPL additions for the DE25-Standard.
 *
 * The DE25's HPS SD/MMC + memory config is electrically the same as the
 * Agilex 5 dev kit, so this just pulls in the dev-kit SPL dtsi (SD-PHY
 * tuning, memory sizing, spl-boot-order, freeze controller) and repoints
 * the FIT at our board's kernel dtb.
 *
 * Auto-appended by the U-Boot build to socfpga_agilex5_de25.dts.
 */
#include "socfpga_agilex5_socdk-u-boot.dtsi"

#if !defined(CONFIG_SOCFPGA_SECURE_VAB_AUTH)
&fdt_0_blob {
	filename = "arch/arm/dts/socfpga_agilex5_de25.dtb";
};

&binman {
	/delete-node/ kernel;
};
#endif
