# Kernel config fragment for the DE25-Standard, merged onto the arm64
# `make defconfig` (which already carries the SoCFPGA stmmac / Cadence
# SDHCI / DWC3 / QSPI drivers).

# Micrel KSZ9031RNX Ethernet PHY
CONFIG_MICREL_PHY=y

# Allow /dev/mem access to arbitrary physical addresses (e.g. the LWH2F
# bridge window, which has no device tree node of its own) - the default
# CONFIG_STRICT_DEVMEM only permits addresses already present in the IO
# resource tree, and the `iomem=relaxed` boot parameter does NOT override
# this on arm64 the way it does on x86 (confirmed empirically: still
# SIGBUS with it set). This is a debug convenience, not something to ship.
# CONFIG_STRICT_DEVMEM is not set

# boot a cpio initramfs from RAM (first-cut rootfs)
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ext4 for an SD rootfs once you switch away from initramfs
CONFIG_EXT4_FS=y
