# U-Boot config fragment for the DE25-Standard, merged onto
# socfpga_agilex5_defconfig.  SD-card boot, no NAND, load Image + dtb +
# initramfs from the FAT partition (mmc 0:1) and booti.
#
# Swap to an ext4 rootfs by dropping the initrd load and setting
#   root=/dev/mmcblk0p3 rootwait
# in CONFIG_BOOTCOMMAND (see linux/README.md).

# upstream QPDS26.1.1 u-boot already ships a working DE25-Nano DT; the
# DE25-Standard shares the HPS/SD/UART/QSPI setup, so reuse it for SPL/U-Boot
# (only the Linux kernel gets this repo's socfpga_agilex5_de25.dts).
CONFIG_DEFAULT_DEVICE_TREE="socfpga_agilex5_de25_nano"
CONFIG_BOOTFILE="Image"

# The board's own socfpga_agilex5_de25_nano_defconfig disables UHS/IO-voltage
# switching (not just the DT) - the generic socfpga_agilex5_defconfig this
# fragment merges onto leaves it enabled. SD/eMMC slots that aren't wired
# for the 3.3V->1.8V UHS signaling switch can end up stuck mid-negotiation
# if software attempts it anyway - every SD command timing out from the very
# first one (SRS12 command-timeout in ATF's driver, silent hang -> watchdog
# reset in U-Boot SPL's) is exactly that failure mode. Matching de25_nano's
# own explicit disables here, not just its DT, closes that gap.
CONFIG_MMC_SPEED_MODE_SET=y
CONFIG_ISO_PARTITION=n
CONFIG_EFI_PARTITION=n
CONFIG_SPL_MMC_UHS_SUPPORT=n
CONFIG_MMC_UHS_SUPPORT=n
CONFIG_SPL_MMC_IO_VOLTAGE=n

# no NAND / UBI on this board
CONFIG_NAND_BOOT=n
CONFIG_SPL_NAND_SUPPORT=n
CONFIG_CMD_NAND=n
CONFIG_MTD_RAW_NAND=n
CONFIG_CMD_UBI=n
CONFIG_CMD_UBIFS=n
CONFIG_MTD_UBI=n
CONFIG_ENV_IS_IN_UBI=n

# explicit boot command (console on UART1)
CONFIG_DISTRO_DEFAULTS=n
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="setenv bootargs console=ttyS0,115200 earlycon=uart8250,mmio32,0x10c02100 root=/dev/ram0 rw init=/sbin/init panic=-1 loglevel=8; mmc dev 0; fatload mmc 0:1 0x86000000 Image; fatload mmc 0:1 0x8c000000 socfpga_agilex5_de25.dtb; fatload mmc 0:1 0x90000000 initramfs.cpio; booti 0x86000000 0x90000000:${filesize} 0x8c000000"

CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_DOS_PARTITION=y
CONFIG_SPL_DOS_PARTITION=y
CONFIG_CMD_PART=y
CONFIG_CMD_DHCP=y
CONFIG_SPL_CRC32=y
CONFIG_LZO=y
