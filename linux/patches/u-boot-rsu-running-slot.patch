+/*
+ * DE25 boards (HPS-first): the SPT name of the image the SDM booted, and the
+ * offset of its FPGA core partition CORE.<name> (0 if there is none). The
+ * factory image's is CORE.FACTORY_IM - SPT names are 16 characters at
+ * most, as for SSBL.FACTORY_IM.
+ */
+int rsu_spl_running_slot(char *name, size_t max_size, u32 *core_offset)
+{
+	struct socfpga_rsu_s10_spt rsu_spt = {0};
+	int crt_spt_index = -EINVAL;
+	const char *slot, *p;
+	unsigned int nentries;
+	size_t plen = strlen(CORE_PART_PREFIX);
+	int i, ret;
+
+	*core_offset = 0;
+	ret = get_spl_slot(&rsu_spt, sizeof(rsu_spt), &crt_spt_index);
+	if (ret)
+		return ret;
+
+	slot = rsu_spt.spt_slot[crt_spt_index].name;
+	if (strlen(slot) + 1 > max_size)
+		return -ENAMETOOLONG;
+	strcpy(name, slot);
+
+	nentries = rsu_spl_spt_nentries(&rsu_spt);
+	for (i = 0; i < (int)nentries; i++) {
+		p = rsu_spt.spt_slot[i].name;
+		if (strncmp(p, CORE_PART_PREFIX, plen))
+			continue;
+		p += plen;
+		if (!strcmp(p, slot) ||
+		    (!strncmp(slot, FACTORY_IMG_NAME, strlen(FACTORY_IMG_NAME)) &&
+		     !strcmp(p, FACTORY_IMG_NAME))) {
+			*core_offset = rsu_spt.spt_slot[i].offset[0];
+			break;
+		}
+	}
+	return 0;
+}
