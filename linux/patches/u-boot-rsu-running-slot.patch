+/*
+ * running_slot [var] - DE25: set var (default rsu_slot) to the name
+ * of the image the SDM booted (P1, FACTORY_IMAGE) and var_core to the
+ * offset of its CORE.<name> partition - U-Boot's preboot loads that
+ * image's FPGA core with them (HPS-first).
+ */
+static int running_slot(int argc, char * const argv[])
+{
+#if IS_ENABLED(CONFIG_SOCFPGA_RSU_MULTIBOOT)
+	const char *var = argc > 1 ? argv[1] : "rsu_slot";
+	char name[MAX_PART_NAME_LENGTH + 1];
+	char core_var[64];
+	u32 core = 0;
+
+	if (rsu_spl_running_slot(name, sizeof(name), &core))
+		return CMD_RET_FAILURE;
+	snprintf(core_var, sizeof(core_var), "%s_core", var);
+	env_set(var, name);
+	if (core)
+		env_set_hex(core_var, core);
+	else
+		env_set(core_var, NULL);
+	return CMD_RET_SUCCESS;
+#else
+	return CMD_RET_FAILURE;
+#endif
+}
